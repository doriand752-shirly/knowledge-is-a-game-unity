# Fastlane — KiAG Flutter IPA → TestFlight (Appy Geek ASC API-key path)
# Never echo API keys. Local: upload_testflight. CI: ci_testflight.

default_platform(:ios)

def load_asc_env!
  env_file = File.expand_path("../asc/.env.asc", __dir__)
  return unless File.exist?(env_file)

  File.readlines(env_file).each do |line|
    next if line.strip.empty? || line.start_with?("#")
    k, v = line.strip.split("=", 2)
    next if k.nil? || v.nil? || v.empty?
    ENV[k] ||= v
  end
end

def asc_api_key
  load_asc_env!
  key_id = ENV["ASC_KEY_ID"]
  issuer = ENV["ASC_ISSUER_ID"]
  key_path = ENV["ASC_KEY_PATH"]
  key_content = ENV["ASC_KEY_P8"]

  UI.user_error!("Missing ASC_KEY_ID / ASC_ISSUER_ID") unless key_id && issuer

  if key_content && !key_content.strip.empty?
    return app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer,
      key_content: key_content.gsub("\\n", "\n"),
      is_key_content_base64: false,
      duration: 1200,
      in_house: false
    )
  end

  UI.user_error!("Missing ASC_KEY_PATH or ASC_KEY_P8") unless key_path && File.exist?(key_path)
  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer,
    key_filepath: key_path,
    duration: 1200,
    in_house: false
  )
end

platform :ios do
  desc "Build Flutter IPA (macOS + Xcode required)"
  lane :build_ipa do
    api = ENV["KIAG_API"] || "http://85.17.145.134:2567"
    sh("cd ../.. && flutter pub get && flutter build ipa --release --dart-define=KIAG_API=#{api}")
  end

  desc "Upload latest IPA to App Store Connect / TestFlight via ASC API key"
  lane :upload_testflight do
    ipa = Dir[File.expand_path("../../build/ios/ipa/*.ipa", __dir__)].max_by { |f| File.mtime(f) }
    UI.user_error!("No IPA found — run build_ipa first") unless ipa

    upload_to_testflight(
      api_key: asc_api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "Build + upload (local Mac)"
  lane :beta do
    build_ipa
    upload_testflight
  end

  desc "CI: certs + Flutter IPA + TestFlight (GitHub Actions macos-latest)"
  lane :ci_testflight do
    setup_ci if ENV["CI"]

    api_key = asc_api_key
    team_id = ENV["APPLE_TEAM_ID"]
    UI.user_error!("Missing APPLE_TEAM_ID") if team_id.to_s.strip.empty?
    api = ENV["KIAG_API"] || "http://85.17.145.134:2567"
    bundle_id = "com.knowledgeisagame.kiagPlayer"

    # Team-level distribution cert + App Store profile for this bundle
    get_certificates(api_key: api_key, platform: "ios")
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: bundle_id,
      adhoc: false,
      readonly: false
    )
    profile_name = ENV["SIGH_NAME"] || lane_context[SharedValues::SIGH_NAME]
    UI.user_error!("PROVISIONING_PROFILE_NAME_MISSING") if profile_name.to_s.strip.empty?
    UI.message("PROVISIONING_PROFILE name=#{profile_name}")

    update_code_signing_settings(
      use_automatic_signing: false,
      path: File.expand_path("../Runner.xcodeproj", __dir__),
      team_id: team_id,
      code_sign_identity: "iPhone Distribution",
      bundle_identifier: bundle_id,
      profile_name: profile_name,
      targets: ["Runner"]
    )

    export_plist = File.expand_path("../ExportOptions.ci.plist", __dir__)
    File.write(
      export_plist,
      <<~PLIST
        <?xml version="1.0" encoding="UTF-8"?>
        <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
        <plist version="1.0">
        <dict>
          <key>method</key>
          <string>app-store</string>
          <key>destination</key>
          <string>export</string>
          <key>signingStyle</key>
          <string>manual</string>
          <key>teamID</key>
          <string>#{team_id}</string>
          <key>provisioningProfiles</key>
          <dict>
            <key>#{bundle_id}</key>
            <string>#{profile_name}</string>
          </dict>
          <key>uploadSymbols</key>
          <true/>
          <key>manageAppVersionAndBuildNumber</key>
          <false/>
        </dict>
        </plist>
      PLIST
    )

    Dir.chdir(File.expand_path("../..", __dir__)) do
      sh("flutter pub get")
      sh(
        "flutter build ipa --release " \
        "--dart-define=KIAG_API=#{api} " \
        "--export-options-plist=#{export_plist}"
      )
    end

    ipa = Dir[File.expand_path("../../build/ios/ipa/*.ipa", __dir__)].max_by { |f| File.mtime(f) }
    UI.user_error!("IPA_MISSING after flutter build ipa") unless ipa
    UI.success("IPA_READY path=#{ipa} size=#{File.size(ipa)}")

    upload = ENV.fetch("UPLOAD_TO_TESTFLIGHT", "true").to_s.downcase
    if %w[1 true yes].include?(upload)
      upload_to_testflight(
        api_key: api_key,
        ipa: ipa,
        skip_waiting_for_build_processing: true,
        distribute_external: false,
        changelog: "CI build — Knowledge is a Game player (Codemagic/GHA)"
      )
      UI.success("UPLOAD_OK TestFlight processing should start shortly")
    else
      UI.important("UPLOAD_SKIPPED (UPLOAD_TO_TESTFLIGHT=#{upload})")
    end
  end
end
