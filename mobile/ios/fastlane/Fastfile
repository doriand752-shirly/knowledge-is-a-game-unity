# Fastlane — mirror Appy Geek ASC API-key upload path for Flutter IPA → TestFlight
# Never echo API keys. Prefer ../asc/upload-ipa.mjs when Fastlane is unavailable.

default_platform(:ios)

platform :ios do
  desc "Build Flutter IPA (macOS + Xcode required)"
  lane :build_ipa do
    api = ENV["KIAG_API"] || "http://85.17.145.134:2567"
    sh("cd ../.. && flutter pub get && flutter build ipa --release --dart-define=KIAG_API=#{api}")
  end

  desc "Upload latest IPA to App Store Connect / TestFlight via ASC API key (Appy Geek style)"
  lane :upload_testflight do
    ipa = Dir[File.expand_path("../../build/ios/ipa/*.ipa", __dir__)].max_by { |f| File.mtime(f) }
    UI.user_error!("No IPA found — run build_ipa first") unless ipa

    key_id = ENV["ASC_KEY_ID"]
    issuer = ENV["ASC_ISSUER_ID"]
    key_path = ENV["ASC_KEY_PATH"]

    env_file = File.expand_path("../asc/.env.asc", __dir__)
    if File.exist?(env_file)
      File.readlines(env_file).each do |line|
        next if line.strip.empty? || line.start_with?("#")
        k, v = line.strip.split("=", 2)
        key_id ||= v if k == "ASC_KEY_ID"
        issuer ||= v if k == "ASC_ISSUER_ID"
        key_path ||= v if k == "ASC_KEY_PATH"
      end
    end

    UI.user_error!("Missing ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_PATH (sync from Appy Geek)") unless key_id && issuer && key_path && File.exist?(key_path)

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer,
      key_filepath: key_path,
      duration: 1200,
      in_house: false
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "Build + upload"
  lane :beta do
    build_ipa
    upload_testflight
  end
end
